---
import { withBase } from '../utils/base.ts';

const guestbookUrl = withBase('/livre-d-or/');
---

<!-- Teaser du livre d'or : la page /livre-d-or/ héberge les messages anonymes.
     Aucun faux message ici. -->
<section class="widget" id="livre-dor" aria-labelledby="livre-dor-titre">
  <h2 class="widget__title" id="livre-dor-titre">Livre d'or</h2>
  <p>Le livre d'or anonyme : un pseudo suffit, pas de compte à créer.</p>
  <p>
    <a href={guestbookUrl}>Voir le livre d'or →</a>
  </p>
  <p class="widget__note">Un pseudo suffit. Les messages sont publics.</p>
</section>
