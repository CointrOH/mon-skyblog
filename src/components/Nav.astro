---
import { withBase } from '../utils/base.ts';

const home = withBase('/');

const links = [
  { href: home, label: 'Accueil' },
  { href: `${home}#articles`, label: 'Articles' },
  { href: `${home}#livre-dor`, label: "Livre d'or" },
  { href: `${home}#webring`, label: 'Webring' },
];
---

<nav class="site-nav" aria-label="Navigation principale">
  <ul>
    {
      links.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
        </li>
      ))
    }
  </ul>
</nav>
