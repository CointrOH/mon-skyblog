---
import { withBase } from '../utils/base.ts';
import { giscus } from '../config/site.ts';

interface Props {
  heading?: string;
  intro?: string;
  sectionId?: string;
  note?: string;
}

const {
  heading = 'Commentaires',
  intro,
  sectionId = 'commentaires',
  note,
} = Astro.props;

const privacyUrl = withBase('/confidentialite/');
const discussionsUrl = 'https://github.com/CointrOH/mon-skyblog/discussions';

// En production, Giscus charge le thème rétro auto-hébergé dans son iframe.
// En développement, on garde le thème `light` pour éviter les problèmes CORS.
const themeUrl = new URL(
  withBase('/giscus-theme.css'),
  import.meta.env.DEV ? Astro.url.origin : (Astro.site ?? Astro.url.origin),
).href;
---

<!-- Commentaires Giscus (GitHub Discussions). Même composant pour les articles
     et pour le livre d'or : seuls le titre, l'introduction et l'identifiant de
     section changent. L'application giscus doit être installée sur le dépôt. -->
<section class="comments" aria-labelledby={`${sectionId}-titre`}>
  <h2 id={`${sectionId}-titre`}>{heading}</h2>

  {intro && <p class="comments__intro">{intro}</p>}
  {note && <p class="comments__note">{note}</p>}

  <p class="comments__note">
    Les commentaires sont hébergés par GitHub Discussions ; un compte GitHub est nécessaire pour
    participer. Les messages sont publics.{' '}
    <a href={privacyUrl}>Politique de confidentialité</a>.
  </p>

  <div class="giscus comments__embed"></div>

  <!-- Repli visible si le script/iframe ne s'affiche pas (blocage, réseau…). -->
  <p class="comments__fallback">
    La zone de commentaires ne s'affiche pas ?{' '}
    <a href={discussionsUrl} target="_blank" rel="noopener noreferrer">
      Ouvrir les Discussions GitHub<span class="sr-only"> (nouvelle fenêtre)</span>
    </a>
  </p>

  <script
    is:inline
    src="https://giscus.app/client.js"
    data-repo={giscus.repo}
    data-repo-id={giscus.repoId}
    data-category={giscus.category}
    data-category-id={giscus.categoryId}
    data-mapping={giscus.mapping}
    data-strict={giscus.strict}
    data-reactions-enabled={giscus.reactionsEnabled}
    data-emit-metadata={giscus.emitMetadata}
    data-input-position={giscus.inputPosition}
    data-theme={import.meta.env.DEV ? giscus.theme : themeUrl}
    data-lang={giscus.lang}
    data-loading={giscus.loading}
    crossorigin="anonymous"
    async></script>

  <noscript>
    <p class="comments__fallback">
      JavaScript est désactivé : la zone de commentaires ne peut pas s'afficher ici.{' '}
      <a href={discussionsUrl} target="_blank" rel="noopener noreferrer">
        Ouvrir les Discussions GitHub<span class="sr-only"> (nouvelle fenêtre)</span>
      </a>
    </p>
  </noscript>
</section>
