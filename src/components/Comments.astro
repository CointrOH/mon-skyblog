---
import { withBase } from '../utils/base.ts';

interface Props {
  heading?: string;
  intro?: string;
  sectionId?: string;
  note?: string;
}

const {
  heading = 'Commentaires',
  intro,
  sectionId = 'commentaires',
  note,
} = Astro.props;

const privacyUrl = withBase('/confidentialite/');
---

<!-- Commentaires momentanément fermés : aucun service tiers, script, iframe
     ni formulaire. Ce composant reste partagé par les articles et le livre
     d'or ; il n'embarque aucune collecte de données. -->
<section class="comments" aria-labelledby={`${sectionId}-titre`}>
  <h2 id={`${sectionId}-titre`}>{heading}</h2>

  {intro && <p class="comments__intro">{intro}</p>}
  {note && <p class="comments__note">{note}</p>}

  <p class="comments__note">
    Les commentaires sont momentanément fermés. Une nouvelle version, sans compte à créer, arrive
    bientôt.
  </p>

  <p class="comments__note">
    <a href={privacyUrl}>Politique de confidentialité</a>
  </p>
</section>
