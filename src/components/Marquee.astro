---
interface Props {
  text?: string;
}

const {
  text = "★ Bienvenue sur mon Skyblog ★ N'oublie pas de signer le livre d'or ★",
} = Astro.props;
---

<div class="marquee-widget">
  <!-- Contrôle de pause (WCAG 2.2.2), en CSS pur et accessible au clavier :
       l'input reste focusable mais est visuellement masqué, le label sert de
       bouton visible et reçoit l'indicateur de focus. Case cochée = défilé figé. -->
  <input type="checkbox" id="pause-defilement" class="marquee__toggle" />
  <label for="pause-defilement" class="marquee__pause">
    <span class="marquee__pause-label marquee__pause-label--pause">⏸ Pause du défilé</span>
    <span class="marquee__pause-label marquee__pause-label--play">▶ Reprendre le défilé</span>
  </label>

  <!-- Piste purement décorative : aucun élément focusable dans ce sous-arbre. -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      <span class="marquee__item">{text}</span>
      <span class="marquee__item">{text}</span>
    </div>
  </div>

  <p class="sr-only">{text}</p>
</div>
