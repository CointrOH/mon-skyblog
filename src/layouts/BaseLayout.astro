---
import '../styles/skyblog.css';
import { withBase } from '../utils/base.ts';
import { goatcounterCode } from '../config/site.ts';
import Banner from '../components/Banner.astro';
import Nav from '../components/Nav.astro';
import Marquee from '../components/Marquee.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Le script de comptage GoatCounter est chargé sur toutes les pages publiques
// (pas sur /admin/, qui a son propre HTML) : le total est ainsi site-wide.
// Code public validé ; vide ou invalide = aucun script, aucun appel externe.
const goatcounter = /^[a-z0-9-]+$/.test(goatcounterCode) ? goatcounterCode : '';

const siteName = 'Mon Skyblog';
const fullTitle = title === siteName ? siteName : `${title} — ${siteName}`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <!-- Politique de sécurité du contenu (CSP) des pages publiques.
         Exceptions volontaires, limitées au service de mesure retenu :
         - script-src : gc.zgo.at (script du compteur GoatCounter) ;
         - img-src : data: pour le pixel transparent de la galerie et https:
           pour les GIF externes éventuels ;
         - connect-src : total du compteur GoatCounter (*.goatcounter.com,
           gc.zgo.at) ;
         - frame-src 'none' : aucun iframe tiers (commentaires fermés).
         La page /admin/ a son propre HTML et n'inclut pas cette CSP. -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline' https://gc.zgo.at; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://*.goatcounter.com https://gc.zgo.at; frame-src 'none'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self';"
    />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <header class="site-header page">
      <Banner />
      <Nav />
      <Marquee />
    </header>
    <main id="contenu" class="page">
      <slot />
    </main>
    <Footer />
    {
      goatcounter && (
        <script
          is:inline
          async
          src="https://gc.zgo.at/count.js"
          data-goatcounter={`https://${goatcounter}.goatcounter.com/count`}
        ></script>
      )
    }
  </body>
</html>
