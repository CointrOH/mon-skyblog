---
import '../styles/skyblog.css';
import { withBase } from '../utils/base.ts';
import { goatcounterCode, commentsApi } from '../config/site.ts';
import Banner from '../components/Banner.astro';
import Nav from '../components/Nav.astro';
import Marquee from '../components/Marquee.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Le script de comptage GoatCounter est chargé sur toutes les pages publiques
// (pas sur /admin/, qui a son propre HTML) : le total est ainsi site-wide.
// Code public validé ; vide ou invalide = aucun script, aucun appel externe.
const goatcounter = /^[a-z0-9-]+$/.test(goatcounterCode) ? goatcounterCode : '';

const siteName = 'Mon Skyblog';
const fullTitle = title === siteName ? siteName : `${title} — ${siteName}`;

// Origine du Worker de commentaires, si l'URL publique est valide. Elle seule
// est autorisée en connect-src : on n'ajoute pas de joker pour les appels POST
// ni pour la lecture des messages. Vide = commentaires désactivés (placeholder).
let commentsOrigin = '';
try {
  const url = new URL(commentsApi);
  if (url.protocol === 'https:') commentsOrigin = url.origin;
} catch {
  commentsOrigin = '';
}

// CSP des pages publiques. Exceptions volontaires et commentées :
// - script-src : gc.zgo.at (GoatCounter) et challenges.cloudflare.com
//   (script Turnstile, chargé uniquement si les commentaires sont actifs) ;
// - img-src : data: pour le pixel transparent de la galerie et https: pour
//   les GIF externes éventuels ;
// - connect-src : total GoatCounter (*.goatcounter.com, gc.zgo.at),
//   vérification Turnstile (challenges.cloudflare.com) et origine du Worker
//   de commentaires (commentsOrigin, si configurée) ;
// - frame-src : challenges.cloudflare.com, qui affiche l'iframe Turnstile
//   (interaction-only) ; aucun autre iframe tiers n'est autorisé.
// La page /admin/ a son propre HTML et n'inclut pas cette CSP.
const contentSecurityPolicy = [
  "default-src 'self'",
  "script-src 'self' 'unsafe-inline' https://gc.zgo.at https://challenges.cloudflare.com",
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data: https:",
  `connect-src 'self' https://*.goatcounter.com https://gc.zgo.at https://challenges.cloudflare.com${commentsOrigin ? ` ${commentsOrigin}` : ''}`,
  'frame-src https://challenges.cloudflare.com',
  "font-src 'self'",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
].join('; ');
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <!-- Politique de sécurité du contenu (CSP) des pages publiques.
         Voir le détail des exceptions (GoatCounter, Turnstile, Worker D1)
         dans le script de ce layout ; la page /admin/ n'inclut pas cette CSP. -->
    <meta http-equiv="Content-Security-Policy" content={contentSecurityPolicy} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <header class="site-header page">
      <Banner />
      <Nav />
      <Marquee />
    </header>
    <main id="contenu" class="page">
      <slot />
    </main>
    <Footer />
    {
      goatcounter && (
        <script
          is:inline
          async
          src="https://gc.zgo.at/count.js"
          data-goatcounter={`https://${goatcounter}.goatcounter.com/count`}
        ></script>
      )
    }
  </body>
</html>
