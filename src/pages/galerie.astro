---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/base.ts';

// Tri par date décroissante, puis résolution de la source :
// fichier uploadé dans la médiathèque (`image`) ou URL externe (`externalUrl`).
const gallery = (await getCollection('gallery'))
  .map((gif) => ({
    ...gif,
    src: gif.data.image ? withBase(gif.data.image) : (gif.data.externalUrl ?? ''),
  }))
  .filter((gif) => gif.src.length > 0)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout
  title="Galerie de GIF"
  description="La galerie de GIF animés du webmaster : paillettes, dragons et pixels, collectionnés depuis 2005."
>
  <h1 class="sr-only">Galerie de GIF</h1>

  {
    gallery.length === 0 ? (
      <p class="panel gallery-empty">Aucun GIF pour le moment.</p>
    ) : (
      <ul class="gallery-grid">
        {gallery.map((gif) => (
          <li class="gallery-card">
            <a
              class="gallery-card__image-link"
              href={gif.src}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Ouvrir le GIF « ${gif.data.title} » (nouvelle fenêtre)`}
            >
              <img
                class="gallery-card__img"
                src={gif.src}
                alt={gif.data.alt}
                loading="lazy"
                decoding="async"
                referrerpolicy="no-referrer"
              />
            </a>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
