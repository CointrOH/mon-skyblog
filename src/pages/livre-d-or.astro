---
import BaseLayout from '../layouts/BaseLayout.astro';
import Comments from '../components/Comments.astro';
---

<BaseLayout
  title="Livre d'or"
  description="Le livre d'or de Mon Skyblog : momentanément fermé, le temps de choisir une solution anonyme."
>
  <h1>Livre d'or</h1>

  <div class="panel">
    <p>
      Avant, chaque page perso avait son livre d'or. Celui-ci prend une petite pause, le temps de
      trouver une solution respectueuse de votre vie privée.
    </p>
    <p>
      Le livre d'or est momentanément fermé. Une version anonyme arrive bientôt.
    </p>
  </div>

  <Comments
    heading="Les messages"
    intro="Aucun message ne peut être déposé pour le moment."
    sectionId="livre-d-or-commentaires"
  />
</BaseLayout>
