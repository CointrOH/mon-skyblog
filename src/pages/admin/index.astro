---
// Page d'administration Decap CMS.
// Le CMS est chargé depuis le paquet npm `decap-cms-app` (bundlé par Vite) :
// aucun script ni asset n'est chargé depuis un CDN au runtime.
const cmsConfigUrl = `${import.meta.env.BASE_URL}admin/config.yml`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Administration — Mon Skyblog</title>
    <!-- Indique explicitement l'URL de la config (base-aware) à Decap CMS.
         L'attribut type est requis par Decap pour reconnaître ce lien. -->
    <link rel="cms-config-url" type="text/yaml" href={cmsConfigUrl} />
  </head>
  <body>
    <noscript>
      <h1>JavaScript requis</h1>
      <p>
        L'interface d'administration de Mon Skyblog a besoin de JavaScript pour fonctionner.
        Activez JavaScript dans votre navigateur, puis rechargez cette page.
      </p>
    </noscript>
    <div id="nc-root"></div>
    <script>
      import CMS from 'decap-cms-app';

      CMS.init();
    </script>
  </body>
</html>
