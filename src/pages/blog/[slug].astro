---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleNav from '../../components/ArticleNav.astro';
import { withBase } from '../../utils/base.ts';
import { entryIdToSlug } from '../../utils/slug.ts';

const dateFormatter = new Intl.DateTimeFormat('fr-FR', {
  dateStyle: 'long',
  timeZone: 'UTC',
});

export async function getStaticPaths() {
  const articles = (await getCollection('blog'))
    .filter((article) => (import.meta.env.PROD ? !article.data.draft : true))
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

  return articles.map((article, index) => ({
    params: { slug: entryIdToSlug(article.id) },
    props: {
      article,
      // « précédent » = article plus ancien ; « suivant » = plus récent.
      previous: articles[index + 1],
      next: articles[index - 1],
    },
  }));
}

interface Props {
  article: CollectionEntry<'blog'>;
  previous?: CollectionEntry<'blog'>;
  next?: CollectionEntry<'blog'>;
}

const { article, previous, next } = Astro.props;
const { Content } = await render(article);

const homeUrl = withBase('/');
const tags = article.data.tags;

// Commentaires fictifs : section clairement étiquetée « démonstration ».
const comments = [
  {
    author: 'xX_darkangel_Xx',
    date: '15 juin 2005 à 21:04',
    body: "Trop fort ce billet, je l'ai mis dans mes favoris !",
  },
  {
    author: 'le visiteur du 56k',
    date: '18 juin 2005 à 14:37',
    body: 'Ça me rappelle mon premier site, quelle époque.',
  },
];
---

<BaseLayout title={article.data.title} description={article.data.description}>
  <nav class="breadcrumbs" aria-label="Fil d'Ariane">
    <ol>
      <li><a href={homeUrl}>Accueil</a></li>
      <li><a href={`${homeUrl}#articles`}>Articles</a></li>
      <li aria-current="page">{article.data.title}</li>
    </ol>
  </nav>

  <article class="article">
    <header class="article__header">
      <h1>{article.data.title}</h1>
      <p class="article__meta">
        Publié le
        <time datetime={article.data.date.toISOString()}>
          {dateFormatter.format(article.data.date)}
        </time>
        {' par '}
        {article.data.author}
      </p>

      {
        tags.length > 0 && (
          <ul class="tag-list" aria-label="Tags de l'article">
            {tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>

    <section class="comments" aria-labelledby="commentaires-titre">
      <h2 id="commentaires-titre">
        Commentaires <span class="comments__badge">démonstration</span>
      </h2>
      <ul class="comments__list">
        {
          comments.map((comment) => (
            <li class="comment">
              <p class="comment__author">
                {comment.author}
                {' — '}
                {comment.date}
              </p>
              <p class="comment__body">« {comment.body} »</p>
            </li>
          ))
        }
      </ul>
      <p class="widget__note">
        Section de démonstration : les commentaires sont fictifs et aucun formulaire n'est
        connecté.
      </p>
    </section>
  </article>

  <ArticleNav previous={previous} next={next} />

  <p>
    <a href={homeUrl}>← Retour à la liste des articles</a>
  </p>
</BaseLayout>
